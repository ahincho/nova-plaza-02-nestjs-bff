# El puerto que escucha el servicio.
PORT=3000

# Orígenes permitidos, separados por coma. Una lista vacía no permite ninguno:
# un contenedor que nadie configuró falla cerrado.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# El ambiente donde corre: development, qa o production. Es lo que hace que una
# sola imagen sirva para los tres. La inyecta la task definition; la imagen trae
# `production`, así que un contenedor sin configurar se comporta como el más
# restrictivo. Con ella se decide, por ejemplo, si se publica la documentación.
NODE_ENV=development

# Un upstream declarado con `defineUpstream('academic')` lee ACADEMIC_URL y
# ACADEMIC_TIMEOUT_MS. Sin la URL el servicio no arranca, y el error nombra la
# variable en vez de responder 500 la primera vez que alguien llame la ruta.
# ACADEMIC_URL=http://localhost:4010
# ACADEMIC_TIMEOUT_MS=3000
