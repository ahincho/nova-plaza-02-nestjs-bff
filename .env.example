# El puerto que escucha el BFF. Sin él, escucha en el 8080 de Plaza.
PORT=8080

# Orígenes permitidos, separados por coma. Una lista vacía no permite ninguno.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# El ambiente: development, qa o production. La imagen trae `production`, que no publica la documentación.
NODE_ENV=development

# Los servicios de Plaza. Sin la URL de uno, el BFF no arranca y el error la nombra. Nada se reintenta (ADR-029).
CATALOG_URL=http://localhost:8082
ORDERS_URL=http://localhost:8081
PAYMENTS_URL=http://localhost:8083
# CATALOG_TIMEOUT_MS=3000

# El emisor de los tokens: el BFF valida la firma con su JWKS, el emisor y el vencimiento.
KEYCLOAK_ISSUER=http://localhost:8180/realms/plaza
